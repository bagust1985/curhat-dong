{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CURHAT DONG Next.js (web / admin)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
