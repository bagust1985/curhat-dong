{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CURHAT DONG NestJS (api / worker)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "noEmit": false,
    "outDir": "./dist",
    "removeComments": true,
    "incremental": true
  }
}
