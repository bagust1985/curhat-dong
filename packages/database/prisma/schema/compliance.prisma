// Compliance, notifications and runtime config — TECH-SPEC BAGIAN 18. PRD §25.

enum ConsentType {
  tos_privacy          // required
  sensitive_processing // required
  analytics            // OPTIONAL — must never gate a core feature
}

enum ConsentMethod {
  onboarding
  settings
  reconsent
}

enum SupportChannel {
  phone
  chat
  whatsapp
  web
}

enum ExportStatus {
  pending
  processing
  ready
  failed
  expired
}

enum NotificationType {
  social
  response
  listener
  ai
  safety
  account
}

/// Delivery state of the push half of a notification (E12-T05, E12-T06).
enum PushStatus {
  /// Not attempted yet.
  pending
  /// Held by quiet hours; `deliver_after` says when it may go out.
  held
  sent
  /// The user switched this type off, or has no registered device.
  skipped
  /// Perishable and would have arrived stale — see PRD §14.
  dropped
  failed
}

enum RetentionRunStatus {
  running
  completed
  failed
}

/// Consent records — PRD §25.3.
///
/// One row per (user, type, document version). Revocation sets `revokedAt`
/// rather than deleting: the history is the compliance evidence, and a refusal
/// is just as much a record as a grant.
model ConsentRecord {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  consentType     ConsentType   @map("consent_type")
  documentVersion String        @map("document_version")
  granted         Boolean
  method          ConsentMethod @default(onboarding)

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, consentType, documentVersion])
  @@index([userId, consentType])
  @@map("consent_records")
}

/// Crisis support resources — PRD §15.2, TECH-SPEC §18.5.
///
/// A dedicated table rather than a blob in app_configs because the runtime
/// query filters on region AND freshness. `verifiedAt` and `sourceUrl` are
/// mandatory: a dead hotline is worse than showing nothing, because someone in
/// crisis tries it, fails, and feels more alone.
model SupportResource {
  id       String         @id @default(uuid()) @db.Uuid
  region   String         @default("ID")
  name     String
  channel  SupportChannel
  value    String
  hours    String
  language String         @default("id")

  isActive Boolean @default(false) @map("is_active")

  /// Entries older than the re-verification window are hidden from users
  /// automatically (PRD §15.2: re-verify every 3 months).
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(6)
  /// Official source. Required — no entry goes live on hearsay.
  sourceUrl  String   @map("source_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([region, isActive, verifiedAt])
  @@map("support_resources")
}

/// Right to portability — PRD §25.2.
model DataExportRequest {
  id     String       @id @default(uuid()) @db.Uuid
  userId String       @map("user_id") @db.Uuid
  status ExportStatus @default(pending)

  fileKey   String?   @map("file_key")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@map("data_export_requests")
}

/// Proof that retention actually ran — PRD §25.4, TECH-SPEC §18.2.
///
/// A `deletedCount` of zero run after run is a sign the job is broken, not a
/// sign that everything is fine.
model RetentionRun {
  id      String @id @default(uuid()) @db.Uuid
  jobName String @map("job_name")
  entity  String

  deletedCount Int                @default(0) @map("deleted_count")
  status       RetentionRunStatus @default(running)
  error        String?            @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([jobName, startedAt(sort: Desc)])
  @@map("retention_runs")
}

/// In-app notification.
///
/// `payload` holds a template key and target ids only. Notification copy comes
/// from a closed template set — curhat content never reaches a notification,
/// in-app or push (CLAUDE.md non-negotiable #3).
model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  type   NotificationType

  payload Json

  /// Idempotency key derived from the event — "comment X on post Y" (E12-T06).
  ///
  /// The unique index is what makes a retried job safe: the second insert
  /// loses to the constraint instead of producing a second notification.
  /// Nullable because a broadcast has no natural event identity.
  dedupeKey String? @map("dedupe_key")

  /// Where the push half of this notification got to.
  ///
  /// Separate from `readAt`: the in-app row always exists, while the push may
  /// have been held by quiet hours, dropped as stale, or refused by the user's
  /// per-type toggle.
  pushStatus  PushStatus @default(pending) @map("push_status")
  /// Set when quiet hours held it — the sweep delivers after this instant.
  deliverAfter DateTime? @map("deliver_after") @db.Timestamptz(6)
  pushedAt     DateTime? @map("pushed_at") @db.Timestamptz(6)

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([pushStatus, deliverAfter])
  @@map("notifications")
}

/// Granular per-type × per-channel preferences (PRD §14).
model NotificationSetting {
  userId String @id @map("user_id") @db.Uuid

  /// { "social": { "push": true, "inApp": true }, ... }
  perTypeToggles Json @default("{}") @map("per_type_toggles")

  /// Quiet hours are honoured for everything except safety and account
  /// notifications (PRD §14).
  quietHoursEnabled Boolean @default(true) @map("quiet_hours_enabled")

  /// User can switch off the Felt Heard prompt permanently (PRD §9).
  feltHeardPromptEnabled Boolean @default(true) @map("felt_heard_prompt_enabled")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Runtime flags — changed without a redeploy (TECH-SPEC §1.1).
model FeatureFlag {
  key         String  @id
  value       Json
  description String?

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

/// Operational configuration: rate limits, moderation SLA, AI quota, quiet
/// hours, feed ranking weights. Values default to the proposals recapped in
/// PRD §25.7 so they can be tuned without a deploy.
model AppConfig {
  key         String  @id
  value       Json
  description String?

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_configs")
}

/// Broadcast type — E14-T15, DESIGN-REF §3.9.
enum BroadcastType {
  announcement
  maintenance
  campaign
  /// The only type exempt from quiet hours (PRD §14).
  safety
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  sent
  cancelled
  failed
}

/// Who a broadcast goes to — E14-T15.
enum BroadcastSegment {
  all
  listeners
  /// Anyone with a session in the last 30 days.
  active_users
  inactive_users
}

/// An admin broadcast — E14-T15. PRD §18, DESIGN-REF §3.9.
///
/// The copy is written by an admin rather than drawn from the notification
/// catalogue, because a maintenance notice cannot be a fixed string. That makes
/// this the one place a human writes push text, so it is stored here, reviewed
/// before sending, and never interpolated with anything about a recipient
/// (CLAUDE.md non-negotiable #3 forbids user content; this forbids user *data*).
model Broadcast {
  id      String           @id @default(uuid()) @db.Uuid
  type    BroadcastType
  status  BroadcastStatus  @default(draft)
  segment BroadcastSegment @default(all)

  title String @db.VarChar(80)
  body  String @db.VarChar(240)

  /// Recipient count shown to the admin at confirmation time.
  ///
  /// Snapshotted rather than recomputed: a broadcast that cannot be recalled
  /// must not be approved against one number and sent against another.
  estimatedRecipients Int @map("estimated_recipients")
  /// Actual notifications created, filled in as the send progresses.
  sentCount           Int @default(0) @map("sent_count")

  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, scheduledFor])
  @@index([createdAt(sort: Desc)])
  @@map("broadcasts")
}

/// Daily metric snapshot — E14-T14. PRD §19.1.
///
/// Aggregated by a job rather than computed when the dashboard opens: the
/// retention and time-to-first-response figures scan large ranges, and a
/// dashboard that takes twenty seconds is a dashboard nobody opens.
///
/// One row per day. Recomputing a day overwrites it, so a backfill is
/// idempotent and a fix to a metric definition can be replayed.
model AnalyticsDaily {
  /// The WIB day this describes, at midnight UTC of that date.
  date DateTime @id @db.Date

  newUsers    Int @default(0) @map("new_users")
  activeUsers Int @default(0) @map("active_users")
  dau         Int @default(0)
  wau         Int @default(0)
  mau         Int @default(0)

  postsPublished Int @default(0) @map("posts_published")
  commentsPosted Int @default(0) @map("comments_posted")

  aiConversations Int @default(0) @map("ai_conversations")
  listenerSessions Int @default(0) @map("listener_sessions")
  activeListeners  Int @default(0) @map("active_listeners")

  /// Felt Heard Rate numerator and denominator, stored separately.
  ///
  /// The North Star (PRD §19.1) — keeping both parts means the rate can be
  /// recomputed if the formula is ever revised, and a period can be summed
  /// correctly rather than by averaging daily percentages.
  feltHeardAnswered Int @default(0) @map("felt_heard_answered")
  feltHeardPositive Int @default(0) @map("felt_heard_positive")
  /// Dismissed prompts, tracked but never in the denominator (PRD §9).
  feltHeardDismissed Int @default(0) @map("felt_heard_dismissed")

  /// Activation: new users who reached a meaningful action within 24h.
  activatedUsers Int @default(0) @map("activated_users")

  /// Posts published today that received >=1 human response within 24h.
  postsWithResponse24h Int @default(0) @map("posts_with_response_24h")
  /// Median seconds from publish to first human response.
  medianFirstResponseSeconds Int? @map("median_first_response_seconds")

  reportsFiled Int @default(0) @map("reports_filed")

  aiCostUsd     Float @default(0) @map("ai_cost_usd")
  aiCallCount   Int   @default(0) @map("ai_call_count")

  casesOpened   Int @default(0) @map("cases_opened")
  casesResolved Int @default(0) @map("cases_resolved")
  slaBreached   Int @default(0) @map("sla_breached")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@map("analytics_daily")
}
