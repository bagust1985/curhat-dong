# Caddy — E17-T01. TECH-SPEC §7.1, §9.1.
#
# TLS is automatic (ACME). What is written down here is everything that is *not*
# automatic: the headers, the CSP, and the fact that Postgres and Redis appear
# nowhere in this file at all — they are bound to loopback in compose and have
# no route into them from the internet by construction, not by rule
# (TECH-SPEC §7.1).

{
	email {$ACME_EMAIL}
	# Staging CA while testing so a broken config does not burn the rate limit
	# on the real one. Commented in production.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(security_headers) {
	header {
		# 2 years, with subdomains, and preload-ready. Every host here is HTTPS
		# only; there is no plain-HTTP endpoint to fall back to.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing in this product needs a camera, a microphone or a location.
		# Saying so removes the question.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# --- Web ---------------------------------------------------------------------
curhatdong.com, www.curhatdong.com {
	import security_headers

	header {
		# Turnstile is the only third-party script allowed, and it is the only
		# reason `script-src` is not `'self'` alone. Cloudflare's challenge
		# needs its own frame, hence frame-src.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.curhatdong.com wss://api.curhatdong.com; frame-src https://challenges.cloudflare.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Only the landing page is indexable (PRD §13). The app sets its own
	# X-Robots-Tag per route; this is the belt to that pair of braces, applied
	# to everything except the root.
	@notRoot not path /
	header @notRoot X-Robots-Tag "noindex, nofollow"

	reverse_proxy web:3000
}

# --- API ---------------------------------------------------------------------
api.curhatdong.com {
	import security_headers

	# An API response is never a document. If a browser is rendering one,
	# something has gone wrong upstream.
	header {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	# Websocket upgrade for the /rt namespace (TECH-SPEC §3.5).
	reverse_proxy api:3001

	# Health endpoints answer without auth and without logging: they are polled
	# every 30 seconds and would otherwise be most of the access log.
	log {
		output stdout
		format json
	}
}

# --- Admin -------------------------------------------------------------------
admin.curhatdong.com {
	import security_headers

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.curhatdong.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Stricter than the public app: an admin page must never be cached or
		# archived anywhere, including by a well-meaning proxy.
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Cache-Control "no-store"
	}

	reverse_proxy admin:3002
}

# HTTP→HTTPS is automatic in Caddy; this block only exists to make the ACME
# challenge path explicit for anyone reading the config.
http:// {
	redir https://{host}{uri} permanent
}
