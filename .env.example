# CURHAT DONG — environment template (TECH-SPEC §12)
#
# Copy to .env and fill in. NEVER commit .env (TECH-SPEC §7.2).
# Placeholder values below are intentionally invalid — the app fails fast at
# boot rather than starting with a fake secret.

# --- APP ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# --- DATABASE ---
DATABASE_URL=postgresql://curhat:curhat@localhost:5432/curhat_dong

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- AUTH (min 32 chars each; generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-me-with-a-real-secret-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-real-secret-min-32-chars
TOKEN_ENCRYPTION_KEY=replace-me-with-a-real-secret-min-32-chars

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- EMAIL ---
# console = log OTP to stdout for local dev, no external calls
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=halo@curhatdong.com

# --- BOT PROTECTION (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- OBJECT STORAGE (S3-compatible / Vultr) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=curhat-dong-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI ---
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Daily spend ceiling in USD. Alerts fire at 70% and 90% (PRD §10).
AI_DAILY_BUDGET=10

# --- EXPO ---
EXPO_ACCESS_TOKEN=
EXPO_PROJECT_ID=

# --- SENTRY ---
SENTRY_DSN=

# --- OPS ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CLIENT (NEXT_PUBLIC_*) ---
# Public by design. Anything secret must NOT be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=
