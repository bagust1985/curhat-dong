{
  "name": "@curhat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "export": "expo export --platform android",
    "eas-build-post-install": "cd ../.. && pnpm turbo run build --filter=@curhat/mobile^...",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@curhat/config": "workspace:*",
    "@curhat/observability": "workspace:*",
    "@curhat/types": "workspace:*",
    "@expo/metro-runtime": "~57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "babel-preset-expo": "~57.0.7",
    "expo": "57.0.13",
    "expo-constants": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "catalog:"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@testing-library/react-native": "13.3.3",
    "@types/react": "catalog:",
    "jsdom": "27.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
