{
  "extends": "../../packages/config/tsconfig/nest.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "@/*": [
        "src/*"
      ]
